# ---------------------------------------------------------------------------
# Copy to backend/.env and fill in. Never commit the filled-in copy.
# ---------------------------------------------------------------------------

ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO
PORT=8080

# --- caller auth ------------------------------------------------------------
# Comma-separated. One key per consumer so you can revoke individually.
# Generate: python -c "import secrets; print('drk_'+secrets.token_urlsafe(32))"
API_KEYS=drk_replace_me

# Local-only escape hatch. Setting ENVIRONMENT=production with this true
# refuses to boot.
AUTH_DISABLED=false

# --- CORS -------------------------------------------------------------------
# Explicit origins only. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000

# --- model providers (set at least one) -------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# --- search -----------------------------------------------------------------
# Without this the service falls back to provider-native search where available.
TAVILY_API_KEY=

# --- research defaults ------------------------------------------------------
DEFAULT_PROVIDER=anthropic
DEFAULT_SEARCH_API=tavily
ALLOW_CLARIFICATION=false          # keep false for unattended integrations
MAX_RESEARCHER_ITERATIONS=3
MAX_REACT_TOOL_CALLS=5
MAX_CONCURRENT_RESEARCH_UNITS=3
RESEARCH_TIMEOUT_SECONDS=900

# --- jobs -------------------------------------------------------------------
JOB_BACKEND=memory                 # memory | redis
REDIS_URL=redis://localhost:6379/0
JOB_RETENTION_SECONDS=86400
MAX_CONCURRENT_JOBS=4

# --- webhooks ---------------------------------------------------------------
# Required if any caller uses callback_url. Signs the payload HMAC-SHA256.
# Generate: python -c "import secrets; print('whsec_'+secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=5

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
