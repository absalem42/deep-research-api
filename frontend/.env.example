# The browser never holds a provider key. It calls the same-origin route at
# /api/research/*, which attaches the service key server-side.
#
# No NEXT_PUBLIC_ prefix: that would ship the value to the browser.
DEEP_RESEARCH_URL=http://localhost:8080
DEEP_RESEARCH_API_KEY=drk_replace_me

# Optional: Google Docs export (browser OAuth, unrelated to the research API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
